def matrix_chain_order(p, n):
    # m[i][j] stores the minimum number of scalar multiplications
    m = [[0 for _ in range(n)] for _ in range(n)]

    # s[i][j] stores the optimal split position
    s = [[0 for _ in range(n)] for _ in range(n)]

    # L is the chain length
    for L in range(2, n):
        for i in range(1, n - L + 1):
            j = i + L - 1
            m[i][j] = float('inf')

            for k in range(i, j):
                cost = (
                    m[i][k]
                    + m[k + 1][j]
                    + p[i - 1] * p[k] * p[j]
                )

                if cost < m[i][j]:
                    m[i][j] = cost
                    s[i][j] = k

    return m, s


def print_optimal_parenthesis(s, i, j):
    if i == j:
        print(f"A{i}", end="")
    else:
        print("(", end="")
        print_optimal_parenthesis(s, i, s[i][j])
        print_optimal_parenthesis(s, s[i][j] + 1, j)
        print(")", end="")


# Main program
n = int(input("Enter number of matrices: "))

p = []
print("Enter the dimensions array:")
for i in range(n + 1):
    p.append(int(input()))

m, s = matrix_chain_order(p, n + 1)

print("\nMinimum number of scalar multiplications:", m[1][n])

print("Optimal parenthesization: ", end="")
print_optimal_parenthesis(s, 1, n)
print()
